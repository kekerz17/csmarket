# --- Общее -------------------------------------------------------------
PORT=4000
CLIENT_URL=http://localhost:5173
# Публичный URL этого backend'а — на него NOWPayments будет слать webhook.
# Локально это НЕ localhost — нужен туннель (ngrok/cloudflared), см. README.
PUBLIC_API_URL=http://localhost:4000

# SteamID64 владельца инвентаря (аккаунт, из которого продаются скины)
STEAM_OWNER_ID64=76561199144809767

# Как часто (мс) синхронизировать инвентарь со Steam
INVENTORY_SYNC_INTERVAL_MS=300000
# Через сколько минут неоплаченный депозит (пополнение баланса) сгорает
DEPOSIT_RESERVATION_MINUTES=30

DATABASE_URL="file:./dev.db"

# --- Админка -------------------------------------------------------------
# Хэш пароля админа. Получить: npm run hash-password -- "мойпароль"
ADMIN_PASSWORD_HASH=
ADMIN_JWT_SECRET=change-me-to-a-random-string

# --- Покупатели (Steam-логин) --------------------------------------------
# Секрет для подписи JWT-cookie покупателей (отдельно от admin) и для
# временной сессии во время OpenID-хендшейка со Steam.
USER_JWT_SECRET=change-me-to-a-random-string
SESSION_SECRET=change-me-to-a-random-string

# --- NOWPayments (крипто-платежи) ----------------------------------------
# Если оставить пустыми — сервер работает в DRY_RUN: заказы создаются,
# но реальный инвойс не выставляется (для локальной проверки без ключей).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# --- Steam trade-бот -------------------------------------------------------
# Аккаунт, который реально держит скины (обычно тот же 76561199144809767).
# Если что-то из этого не задано — бот работает в DRY_RUN (эмулирует выдачу).
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
# shared_secret и identity_secret извлекаются из мобильного аутентификатора,
# см. инструкцию в README — храните их так же бережно, как пароль.
STEAM_SHARED_SECRET=
STEAM_IDENTITY_SECRET=
# Нужен и боту, и Steam-логину покупателей ("Войти через Steam"). В отличие
# от секретов выше — бесплатный и мгновенный, получить можно на
# steamcommunity.com/dev/apikey без привязки мобильного аутентификатора.
# Без него вместо реального логина работает тестовый /api/auth/dev-login.
STEAM_API_KEY=
