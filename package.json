{
  "name": "cs2-skin-store",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "prisma:migrate": "npm run prisma:migrate -w server",
    "hash-password": "npm run hash-password -w server --"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "protobufjs@7.6.5": true,
    "protobufjs@6.11.6": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
